# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/kantillon_dev

# Auth
# Generate a strong random string for production, e.g.: openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-development-only-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=kantillon_token

# Frontend origin allowed to make credentialed requests (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Rate limiting (auth endpoints)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
